generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  profileImage        String?
  role                Role                 @default(USER)
  isActive            Boolean              @default(true)
  deletedAt           DateTime?
  userShows           UserShow[]
  passwordResetTokens PasswordResetToken[]

  @@index([deletedAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("Password_Reset_Tokens")
}

model Show {
  id            String     @id @default(uuid())
  external_id   String     @unique
  title         String
  description   String?
  mediaType     String
  imageUrl      String?
  duration      Int?
  totalEpisodes Int?
  releaseDate   String?
  userShows     UserShow[]

  @@unique([external_id, mediaType])
}

model UserShow {
  id          String       @id @default(uuid())
  user_id     String
  show_id     String
  time_commit Time_Commit?
  status      Status?
  rating      Int?
  mood        Mood[]
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  show        Show         @relation(fields: [show_id], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, show_id])
  @@index([deletedAt])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  watching
  completed
  plan_to_watch
  dropped
}

enum Mood {
  happy
  sad
  romantic
  chill
  excited
  nerdy
  mad
  stressed
  bored
  lonely
  energetic
  tragic
  tense
}

enum Time_Commit {
  around_30_min
  between_1_and_3_hours
  binge
}
