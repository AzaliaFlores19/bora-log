# ===== Server =====
PORT=4000

# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bora_log_db?schema=public"

# ===== Auth =====
# Use a long, random string in production
JWT_SECRET="change-me-to-a-long-random-secret"

# ===== TMDB (The Movie Database) =====
# Create a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# ===== Email (password reset) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""

# ===== Frontend (used for CORS and the password reset link) =====
FRONTEND_URL=http://localhost:3000

# ===== Seeder =====
# Initial admin account created by `npm run seed`
SEED_ADMIN_NAME="Bora Admin"
SEED_ADMIN_EMAIL="admin@boralog.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Demo data is seeded in development by default. Set to false to disable it.
SEED_DEMO=false
